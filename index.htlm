enerique", 57, 0.4, 13, 0.1, ["poire", "fruit"]], ["Orange", "Generique", 47, 0.9, 10, 0.1, ["orange", "fruit", "agrume"]], ["Mangue", "Generique", 65, 0.8, 15, 0.4, ["mangue", "fruit", "tropical"]], ["Fraises", "Generique", 32, 0.7, 6, 0.3, ["fraises", "fruit", "rouge"]], ["Myrtilles", "Generique", 57, 0.7, 12, 0.3, ["myrtilles", "fruit", "rouge"]], ["Fruits rouges", "Generique", 45, 0.8, 8, 0.4, ["fruits rouges", "baies", "fruit"]], ["Kiwi", "Generique", 61, 1.1, 13, 0.5, ["kiwi", "fruit"]], ["Avocat", "Generique", 160, 2, 2, 15, ["avocat", "fruit", "gras"]], ["Huile d olive", "Generique", 884, 0, 0, 100, ["huile", "olive", "matiere grasse"]], ["Huile de coco", "Generique", 900, 0, 0, 100, ["huile", "coco", "matiere grasse"]], ["Beurre doux", "President", 717, 0.7, 0.7, 82, ["beurre", "laitier", "matiere grasse", "president"]], ["Amandes nature", "Generique", 579, 21, 7, 50, ["amandes", "oleagineux", "noix"]], ["Noix de cajou", "Generique", 553, 18, 26, 44, ["cajou", "noix", "oleagineux"]], ["Noix", "Generique", 654, 15, 14, 65, ["noix", "oleagineux"]], ["Beurre de cacahuete", "Generique", 598, 25, 20, 50, ["beurre cacahuete", "arachide", "oleagineux"]], ["Graines de chia", "Generique", 486, 17, 42, 31, ["chia", "graines", "superaliment"]], ["Compote de pommes sans sucre", "Materne", 36, 0.3, 7, 0.1, ["compote", "pommes", "materne", "fruit"]], ["Compote de pommes", "Andros", 55, 0.2, 12, 0.2, ["compote", "pommes", "andros", "fruit"]], ["Miel", "Generique", 304, 0.3, 82, 0, ["miel", "sucre", "naturel"]], ["Confiture fraises", "Bonne Maman", 248, 0.5, 57, 0.1, ["confiture", "fraises", "bonne maman"]], ["Houmous nature", "Generique", 166, 8, 12, 10, ["houmous", "pois chiches", "legumineuses"]], ["Chocolat noir 70%", "Generique", 598, 8, 32, 43, ["chocolat", "noir", "cacao"]], ["Sauce tomate", "Heinz", 42, 1.7, 7, 0.8, ["sauce", "tomate", "heinz"]], ["Muesli nature", "Bjorg", 380, 10, 62, 9, ["muesli", "cereales", "bjorg"]], ["Corn flakes", "Kellogg's", 370, 7, 84, 0.9, ["corn flakes", "kelloggs", "cereales"]], ["Tofu nature", "Generique", 76, 8, 0.5, 4.8, ["tofu", "soja", "vegetal", "proteines"]], ["Tofu fume", "Generique", 135, 14, 2, 8, ["tofu", "fume", "vegetal", "proteines"]], ["Tempeh", "Generique", 193, 19, 7, 11, ["tempeh", "soja", "vegetal", "proteines"]], ["Seitan", "Generique", 150, 25, 6, 2, ["seitan", "ble", "vegetal", "proteines"]], ["Eau plate", "Generique", 0, 0, 0, 0, ["eau", "boisson"]], ["Jus d orange frais", "Generique", 45, 0.7, 10, 0.2, ["jus", "orange", "boisson"]]];

function jnNorm(s) {
  return (s||'').toLowerCase()
    .replace(/[eÃ©Ã¨ÃªÃ«]/g,'e').replace(/[aÃ Ã¢]/g,'a')
    .replace(/[uÃ¹Ã»Ã¼]/g,'u').replace(/[iÃ®Ã¯]/g,'i')
    .replace(/[oÃ´Ã¶]/g,'o').replace(/[cÃ§]/g,'c')
    .replace(/[^a-z0-9 ]/g,' ').replace(/\s+/g,' ').trim();
}

function jnSearch() {
  var q = jnNorm(document.getElementById('jn-search-input').value);
  if (!q) return;
  var res = document.getElementById('jn-search-results');
  document.getElementById('jn-qty-form').style.display = 'none';
  JN.selectedFood = null;

  var words = q.split(' ').filter(function(w){return w.length>1;});

  var scored = FOODS.map(function(f) {
    var nameN = jnNorm(f[0]);
    var brandN = jnNorm(f[1]);
    var tags = f[6].map(function(t){return jnNorm(t);});
    var score = 0;
    words.forEach(function(w) {
      if (nameN.indexOf(w) === 0) score += 10;
      else if (nameN.indexOf(w) !== -1) score += 6;
      if (brandN.indexOf(w) !== -1) score += 4;
      tags.forEach(function(t) {
        if (t === w) score += 5;
        else if (t.indexOf(w) !== -1) score += 2;
      });
    });
    return {f:f, score:score};
  }).filter(function(x){return x.score>0;})
    .sort(function(a,b){return b.score-a.score;})
    .slice(0,8);

  if (scored.length === 0) {
    res.innerHTML = '<div style="text-align:center;padding:1.5rem 0;color:#bbb;font-size:13px;font-weight:300;">Aucun aliment trouvÃ©.<br>Essaie : poulet, riz, yaourt, pain...</div>';
    return;
  }

  JN.searchResults = scored.map(function(x){return x.f;});
  var h = '';
  scored.forEach(function(x,i) {
    var f = x.f;
    var brand = f[1] === 'Generique' ? '' : f[1];
    h += '<div class="search-result-item" data-action="selectfood" data-idx="'+i+'">';
    h += '<div class="sri-name">'+f[0]+'</div>';
    if (brand) h += '<div class="sri-brand">'+brand+'</div>';
    h += '<div class="sri-macros">Pour 100g Â· '+f[2]+' kcal Â· P:'+f[3]+'g G:'+f[4]+'g L:'+f[5]+'g</div>';
    h += '</div>';
  });
  res.innerHTML = h;
}

function jnSelectFood(idx) {
  var f = JN.searchResults[idx];
  if (!f) return;
  var brand = f[1] === 'Generique' ? '' : ' ('+f[1]+')';
  JN.selectedFood = {name:f[0]+brand, cal100:f[2], p100:f[3], g100:f[4], l100:f[5]};
  document.getElementById('jn-selected-name').textContent = JN.selectedFood.name;
  document.getElementById('jn-selected-macros').textContent = 'Pour 100g Â· '+f[2]+' kcal Â· P:'+f[3]+'g G:'+f[4]+'g L:'+f[5]+'g';
  document.getElementById('jn-qty-input').value = '100';
  document.getElementById('jn-qty-form').style.display = 'block';
  document.getElementById('jn-qty-input').focus();
}

function jnAddFood() {
  if (!JN.selectedFood || !JN.currentMeal) return;
  var qty = parseFloat(document.getElementById('jn-qty-input').value)||100;
  var ratio = qty/100;
  var day = jnGetDay();
  day[JN.currentMeal].push({
    name: JN.selectedFood.name,
    qty: qty,
    cal: JN.selectedFood.cal100*ratio,
    p: JN.selectedFood.p100*ratio,
    g: JN.selectedFood.g100*ratio,
    l: JN.selectedFood.l100*ratio
  });
  jnSave();
  jnCloseSearch();
  jnRender();
}

// Init journal
jnLoad();
document.addEventListener('click', function(e) {
  var t = e.target;
  // Walk up to find data-action element
  while (t && t !== document.body) {
    var action = t.getAttribute && t.getAttribute('data-action');
    if (action === 'del') {
      jnDel(t.getAttribute('data-meal'), parseInt(t.getAttribute('data-idx')));
      return;
    }
    if (action === 'addfood') {
      jnOpenSearch(t.getAttribute('data-meal'));
      return;
    }
    if (action === 'selectfood') {
      jnSelectFood(parseInt(t.getAttribute('data-idx')));
      return;
    }
    t = t.parentElement;
  }
});
document.getElementById('jn-prev').addEventListener('click',function(){
  JN.currentDate.setDate(JN.currentDate.getDate()-1);
  jnRender();
});
document.getElementById('jn-next').addEventListener('click',function(){
  var today=new Date();
  if(jnDateKey(JN.currentDate)!==jnDateKey(today)){
    JN.currentDate.setDate(JN.currentDate.getDate()+1);
    jnRender();
  }
});
document.getElementById('jn-modal-close').addEventListener('click',jnCloseSearch);
document.getElementById('jn-search-btn').addEventListener('click',jnSearch);
document.getElementById('jn-add-food-btn').addEventListener('click',jnAddFood);
document.getElementById('jn-search-input').addEventListener('keypress',function(e){
  if(e.key==='Enter') jnSearch();
});
document.getElementById('jn-qty-input').addEventListener('keypress',function(e){
  if(e.key==='Enter') jnAddFood();
});
jnRender();

// Sub-tabs courses
document.addEventListener('click',function(e){
var t=e.target;
if(!t)return;
if(t.id==='stb-liste'||t.id==='stb-perso'){
var goListe=t.id==='stb-liste';
var sl=document.getElementById('stb-liste');
var sp=document.getElementById('stb-perso');
var scl=document.getElementById('sc-liste');
var scp=document.getElementById('sc-perso');
if(!sl||!sp||!scl||!scp)return;
if(goListe){
sl.style.background='#364d44';sl.style.color='#FDFAF5';sl.style.border='none';
sp.style.background='#FDFAF5';sp.style.color='#364d44';sp.style.border='1.5px solid #EDE5D8';
scl.style.display='block';scp.style.display='none';
}else{
sp.style.background='#364d44';sp.style.color='#FDFAF5';sp.style.border='none';
sl.style.background='#FDFAF5';sl.style.color='#364d44';sl.style.border='1.5px solid #EDE5D8';
scl.style.display='none';scp.style.display='block';
}
}
if(t.id==='add-btn'){addItem();}
});

document.addEventListener('keypress',function(e){
var inp=document.getElementById('new-item');
if(e.key==='Enter'&&inp&&inp===document.activeElement)addItem();
});

function addItem(){
var input=document.getElementById('new-item');
if(!input)return;
var val=input.value.trim();
if(!val)return;
var list=document.getElementById('perso-list');
var empty=document.getElementById('perso-empty');
var div=document.createElement('div');
div.style.cssText='display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #EDE5D8;';
var circle=document.createElement('div');
circle.style.cssText='width:22px;height:22px;border-radius:50%;border:1.5px solid #EDE5D8;flex-shrink:0;cursor:pointer;-webkit-tap-highlight-color:transparent;touch-action:manipulation;';
circle.setAttribute('data-done','0');
var txt=document.createElement('span');
txt.style.cssText='flex:1;font-size:14px;color:#364d44;font-weight:300;cursor:pointer;';
txt.textContent=val;
circle.addEventListener('click',function(){toggleItem(circle,txt);});
txt.addEventListener('click',function(){toggleItem(circle,txt);});
var del=document.createElement('button');
del.style.cssText='background:none;border:none;color:#ccc;font-size:20px;cursor:pointer;padding:0 4px;-webkit-tap-highlight-color:transparent;line-height:1;';
del.textContent='Ã';
del.addEventListener('click',function(){
div.remove();
if(list.children.length===0)empty.style.display='block';
});
div.appendChild(circle);div.appendChild(txt);div.appendChild(del);
list.appendChild(div);
empty.style.display='none';
input.value='';
}

function toggleItem(circle,txt){
var done=circle.getAttribute('data-done')==='1';
if(!done){
circle.setAttribute('data-done','1');
circle.style.background='#C96A52';circle.style.borderColor='#C96A52';
circle.innerHTML='<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="#FDFAF5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
txt.style.textDecoration='line-through';txt.style.color='#bbb';
}else{
circle.setAttribute('data-done','0');
circle.style.background='none';circle.style.borderColor='#EDE5D8';
circle.innerHTML='';
txt.style.textDecoration='none';txt.style.color='#364d44';
}
}
</script>
</body>
</html>
