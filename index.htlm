<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Thierry - Le Cloud</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
html,body{background:#F5EFE6;margin:0;padding:0;}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Jost',sans-serif;background:#F5EFE6;}
.hd{background:#364d44;padding:2rem 1.25rem 1.25rem;text-align:center;}
.hd img{width:100px;height:100px;border-radius:50%;object-fit:cover;display:block;margin:0 auto 10px;}
.hn{font-family:'Cormorant Garamond',serif;font-size:30px;color:#FDFAF5;}
.tabs{background:#364d44;padding:.75rem 1rem;display:flex;gap:6px;}
.tb{flex:1;padding:10px 4px;font-size:11px;text-align:center;cursor:pointer;border-radius:10px;border:none;font-family:'Jost',sans-serif;font-weight:500;background:#F5EFE6;color:#364d44;-webkit-tap-highlight-color:transparent;touch-action:manipulation;}
.tb.on{background:#C96A52;color:#FDFAF5;}
.pn{display:none;padding:1rem 1rem 2rem;max-width:480px;margin:0 auto;background:#F5EFE6;}
.pn.on{display:block;}
.card{background:#FDFAF5;border-radius:20px;padding:1.25rem;margin-bottom:.85rem;}
.stit{font-size:10px;color:#C96A52;letter-spacing:2.5px;text-transform:uppercase;margin-bottom:12px;font-weight:500;}
.msg{font-family:'Cormorant Garamond',serif;font-size:16px;color:#364d44;line-height:1.75;font-style:italic;margin-bottom:1rem;}
.mg{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:1rem;}
.mb{border-radius:16px;padding:14px 10px;text-align:center;}
.mb.main{background:#C96A52;}
.mb.main .mv{color:#FDFAF5;}
.mb.main .ml{color:#f0c4b4;}
.mb:not(.main){background:#F5EFE6;}
.mb:not(.main) .mv{color:#364d44;}
.mb:not(.main) .ml{color:#C96A52;}
.mv{font-family:'Cormorant Garamond',serif;font-size:28px;}
.ml{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;margin-top:3px;font-weight:500;}
.dv{height:1px;background:#EDE5D8;margin:.85rem 0;}
.pr{display:flex;justify-content:space-between;font-size:12px;color:#364d44;padding:4px 0;font-weight:300;}
.pv{color:#C96A52;font-weight:500;}
.bb{background:#364d44;border-radius:14px;padding:1rem;margin-bottom:.85rem;text-align:center;}
.bl{font-size:10px;color:#9FD4BC;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;font-weight:300;}
.bv{font-family:'Cormorant Garamond',serif;font-size:22px;color:#FDFAF5;}
.bs{font-size:11px;color:#9FD4BC;margin-top:3px;font-weight:300;}
.sn{background:#F5EFE6;border-radius:12px;padding:.75rem;margin-bottom:.85rem;font-size:12px;color:#364d44;text-align:center;border:1px solid #EDE5D8;}
.cat{font-size:10px;color:#C96A52;letter-spacing:2px;text-transform:uppercase;margin:14px 0 7px;font-weight:500;}
.cat:first-child{margin-top:0;}
.ci{display:flex;align-items:flex-start;gap:9px;padding:8px 0;border-bottom:1px solid #EDE5D8;font-size:13px;color:#364d44;font-weight:300;}
.ci:last-child{border-bottom:none;}
.dot{width:5px;height:5px;border-radius:50%;background:#C96A52;flex-shrink:0;margin-top:6px;}
.jc{background:#FDFAF5;border-radius:18px;margin-bottom:.85rem;overflow:hidden;}
.jh{background:#364d44;padding:.85rem 1.1rem;display:flex;justify-content:space-between;}
.jhn{font-family:'Cormorant Garamond',serif;font-size:15px;color:#FDFAF5;}
.jhc{font-size:11px;color:#9FD4BC;font-weight:300;}
.jb{padding:1rem 1.1rem;}
.rb{margin-bottom:.85rem;}
.rb:last-child{margin-bottom:0;}
.rl{font-size:9px;color:#C96A52;letter-spacing:2px;text-transform:uppercase;margin-bottom:5px;font-weight:500;}
.rn{font-family:'Cormorant Garamond',serif;font-size:16px;color:#364d44;margin-bottom:7px;}
.ri{list-style:none;}
.ri li{font-size:12px;color:#555;padding:2px 0;display:flex;gap:8px;font-weight:300;}
.ri .g{font-size:11px;color:#C96A52;font-weight:500;min-width:56px;flex-shrink:0;}
.rm{font-size:11px;color:#aaa;margin-top:6px;padding-top:6px;border-top:1px solid #EDE5D8;}
.rh{height:1px;background:#EDE5D8;margin:.75rem 0;}
.ft{text-align:center;padding:2rem 1rem;background:#F5EFE6;}
.meal-card{background:#FDFAF5;border-radius:18px;margin-bottom:.85rem;overflow:hidden;}
.meal-head{background:#F5EFE6;padding:.75rem 1rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #EDE5D8;}
.meal-name{font-size:11px;color:#C96A52;letter-spacing:2px;text-transform:uppercase;font-weight:500;}
.meal-cals{font-size:11px;color:#999;font-weight:300;}
.meal-body{padding:.75rem 1rem;}
.food-item{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #EDE5D8;font-size:13px;}
.food-item:last-child{border-bottom:none;}
.food-name{color:#364d44;font-weight:300;flex:1;}
.food-macros{font-size:11px;color:#999;font-weight:300;text-align:right;margin-right:10px;}
.food-del{background:none;border:none;color:#ddd;font-size:18px;cursor:pointer;-webkit-tap-highlight-color:transparent;padding:0 4px;line-height:1;}
.add-food-btn{display:flex;align-items:center;gap:6px;background:none;border:1.5px dashed #EDE5D8;border-radius:12px;padding:8px 12px;width:100%;margin-top:8px;cursor:pointer;color:#999;font-size:12px;font-family:'Jost',sans-serif;-webkit-tap-highlight-color:transparent;touch-action:manipulation;}
.search-result-item{padding:10px 0;border-bottom:1px solid #EDE5D8;cursor:pointer;-webkit-tap-highlight-color:transparent;}
.search-result-item:last-child{border-bottom:none;}
.sri-name{font-size:13px;color:#364d44;font-weight:400;margin-bottom:2px;}
.sri-brand{font-size:11px;color:#C96A52;font-weight:300;}
.sri-macros{font-size:11px;color:#999;font-weight:300;}
.ftn{font-family:'Cormorant Garamond',serif;font-size:18px;color:#364d44;}
.fts{font-size:10px;color:#C96A52;letter-spacing:2px;text-transform:uppercase;margin-top:4px;font-weight:300;}
</style>
</head>
<body>
<div class="hd">
<img src="data:image/png;base64," alt="Le Cloud"/>
<div class="hn">Thierry</div>
</div>
<div class="tabs">
<button class="tb on" id="tb-m">Macros</button>
<button class="tb" id="tb-c">Courses</button>
<button class="tb" id="tb-j">Journ&eacute;e type</button>
<button class="tb" id="tb-jn">Mon journal</button>
</div>
<div class="pn on" id="pn-m"><div class="card"><div class="msg">Ce plan a ete concu specialement pour toi. Suis-le avec regularite et les resultats seront au rendez-vous.</div><div class="dv"></div><div class="stit">Tes macros journalieres</div><div class="mg"><div class="mb main"><div class="mv">2009</div><div class="ml">Calories/jour</div></div><div class="mb"><div class="mv">149g</div><div class="ml">Proteines</div></div><div class="mb"><div class="mv">194g</div><div class="ml">Glucides</div></div><div class="mb"><div class="mv">71g</div><div class="ml">Lipides</div></div></div><div class="dv"></div><div class="pr"><span>Proteines</span><span class="pv">30%</span></div><div class="pr"><span>Glucides</span><span class="pv">38%</span></div><div class="pr"><span>Lipides</span><span class="pv">32%</span></div></div></div>
<div class="pn" id="pn-c"><div style="background:#F5EFE6;"><div style="display:flex;gap:8px;margin-bottom:1rem;"><button id="stb-liste" style="flex:1;padding:10px 6px;font-size:12px;border-radius:50px;border:none;background:#364d44;color:#FDFAF5;font-family:Jost,sans-serif;font-weight:500;cursor:pointer;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">Mes courses</button><button id="stb-perso" style="flex:1;padding:10px 6px;font-size:12px;border-radius:50px;border:1.5px solid #EDE5D8;background:#FDFAF5;color:#364d44;font-family:Jost,sans-serif;font-weight:400;cursor:pointer;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">Ma liste perso</button></div><div id="sc-liste"><div class="bb"><div class="bl">Budget courses estime</div><div class="bv">85-110€/sem</div></div><div class="sn">Liste de courses pour 1 semaine</div><div class="card"><div class="cat">Proteines</div><div class="ci"><div class="dot"></div><span>Blanc de poulet 800g</span></div><div class="ci"><div class="dot"></div><span>Saumon 4 paves</span></div><div class="ci"><div class="dot"></div><span>Thon naturel 4 boites</span></div><div class="ci"><div class="dot"></div><span>Fromage blanc 0% 500g</span></div><div class="ci"><div class="dot"></div><span>Skyr nature 500g</span></div><div class="cat">Feculent</div><div class="ci"><div class="dot"></div><span>Riz complet 1kg</span></div><div class="ci"><div class="dot"></div><span>Patate douce x4</span></div><div class="ci"><div class="dot"></div><span>Flocons avoine 500g</span></div><div class="ci"><div class="dot"></div><span>Pain seigle 1 paquet</span></div><div class="cat">Legumes frais</div><div class="ci"><div class="dot"></div><span>Brocoli x2</span></div><div class="ci"><div class="dot"></div><span>Courgettes x4</span></div><div class="ci"><div class="dot"></div><span>Epinards 300g</span></div><div class="ci"><div class="dot"></div><span>Tomates cerises 500g</span></div><div class="ci"><div class="dot"></div><span>Carottes 500g</span></div><div class="ci"><div class="dot"></div><span>Champignons 250g</span></div><div class="cat">Legumes surgeles</div><div class="ci"><div class="dot"></div><span>Haricots verts 750g</span></div><div class="ci"><div class="dot"></div><span>Epinards surgeles 500g</span></div><div class="cat">Fruits</div><div class="ci"><div class="dot"></div><span>Bananes x5</span></div><div class="ci"><div class="dot"></div><span>Pommes x5</span></div><div class="ci"><div class="dot"></div><span>Fruits rouges 500g</span></div><div class="cat">Produits laitiers</div><div class="ci"><div class="dot"></div><span>Yaourt grec 0% x4</span></div><div class="ci"><div class="dot"></div><span>Lait demi-ecreme 1L</span></div><div class="ci"><div class="dot"></div><span>Fromage blanc 0% 500g</span></div><div class="cat">Matieres grasses</div><div class="ci"><div class="dot"></div><span>Avocats x3</span></div><div class="ci"><div class="dot"></div><span>Amandes 150g</span></div><div class="ci"><div class="dot"></div><span>Huile olive 50cl</span></div><div class="ci"><div class="dot"></div><span>Graines chia 100g</span></div></div></div><div id="sc-perso" style="display:none;"><div class="card"><div class="stit">Ma liste personnelle</div><div style="display:flex;gap:8px;margin-bottom:12px;"><input type="text" id="new-item" placeholder="Ajouter un article..." style="flex:1;background:#F5EFE6;border:1px solid #EDE5D8;border-radius:12px;padding:10px 14px;font-size:14px;color:#364d44;outline:none;font-family:Jost,sans-serif;"/><button id="add-btn" style="background:#C96A52;color:#FDFAF5;border:none;border-radius:12px;padding:10px 18px;font-size:20px;cursor:pointer;-webkit-tap-highlight-color:transparent;touch-action:manipulation;line-height:1;">+</button></div><div id="perso-list"></div><div id="perso-empty" style="text-align:center;padding:1rem 0;font-size:13px;color:#bbb;font-weight:300;">Ta liste est vide. Ajoute tes articles !</div></div></div></div></div>
<div class="pn" id="pn-j"><div class="jc"><div class="jh"><span class="jhn">Journee 1</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Porridge proteine</div><ul class="ri"><li><span class="g">80g</span><span>Flocons avoine</span></li><li><span class="g">200ml</span><span>Lait demi-ecreme</span></li><li><span class="g">100g</span><span>Fruits rouges</span></li><li><span class="g">100g</span><span>Skyr nature</span></li></ul><div class="rm">442 kcal P:33g G:43g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Blanc de poulet grille</div><ul class="ri"><li><span class="g">150g</span><span>Blanc de poulet</span></li><li><span class="g">150g</span><span>Riz complet</span></li><li><span class="g">200g</span><span>Brocoli</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Skyr banane</div><ul class="ri"><li><span class="g">150g</span><span>Skyr nature</span></li><li><span class="g">1 unite</span><span>Banane</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Saumon vapeur</div><ul class="ri"><li><span class="g">150g</span><span>Saumon</span></li><li><span class="g">150g</span><span>Patate douce</span></li><li><span class="g">150g</span><span>Epinards</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 2</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Bowl energisant</div><ul class="ri"><li><span class="g">80g</span><span>Flocons avoine</span></li><li><span class="g">150g</span><span>Yaourt grec 0%</span></li><li><span class="g">1 unite</span><span>Banane</span></li><li><span class="g">20g</span><span>Amandes</span></li></ul><div class="rm">442 kcal P:33g G:43g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Thon naturel crudites</div><ul class="ri"><li><span class="g">120g</span><span>Thon naturel</span></li><li><span class="g">150g</span><span>Riz complet</span></li><li><span class="g">150g</span><span>Tomates cerises</span></li><li><span class="g">100g</span><span>Carottes</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Fruit amandes</div><ul class="ri"><li><span class="g">1 unite</span><span>Pomme</span></li><li><span class="g">20g</span><span>Amandes</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Blanc de poulet marine courgettes</div><ul class="ri"><li><span class="g">150g</span><span>Blanc de poulet</span></li><li><span class="g">200g</span><span>Courgettes</span></li><li><span class="g">120g</span><span>Riz complet</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 3</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Tartines fromage blanc</div><ul class="ri"><li><span class="g">2 tranches</span><span>Pain seigle</span></li><li><span class="g">150g</span><span>Fromage blanc 0%</span></li><li><span class="g">80g</span><span>Fruits rouges</span></li></ul><div class="rm">462 kcal P:34g G:45g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Saumon champignons</div><ul class="ri"><li><span class="g">150g</span><span>Saumon</span></li><li><span class="g">150g</span><span>Brocoli</span></li><li><span class="g">150g</span><span>Champignons</span></li><li><span class="g">150g</span><span>Patate douce</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Yaourt fruits rouges</div><ul class="ri"><li><span class="g">150g</span><span>Yaourt grec 0%</span></li><li><span class="g">100g</span><span>Fruits rouges</span></li></ul><div class="rm">241 kcal P:18g G:23g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Thon naturel saute riz</div><ul class="ri"><li><span class="g">120g</span><span>Thon naturel</span></li><li><span class="g">150g</span><span>Riz complet</span></li><li><span class="g">150g</span><span>Haricots verts</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 4</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Smoothie bowl</div><ul class="ri"><li><span class="g">60g</span><span>Flocons avoine</span></li><li><span class="g">1 unite</span><span>Banane</span></li><li><span class="g">80g</span><span>Fruits rouges</span></li><li><span class="g">15g</span><span>Graines chia</span></li></ul><div class="rm">442 kcal P:33g G:43g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Blanc de poulet epinards</div><ul class="ri"><li><span class="g">150g</span><span>Blanc de poulet</span></li><li><span class="g">150g</span><span>Epinards</span></li><li><span class="g">100g</span><span>Tomates cerises</span></li><li><span class="g">150g</span><span>Patate douce</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">723 kcal P:54g G:70g L:26g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Galette houmous</div><ul class="ri"><li><span class="g">2 unites</span><span>Galette riz</span></li><li><span class="g">30g</span><span>Houmous</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Saumon au four</div><ul class="ri"><li><span class="g">150g</span><span>Saumon</span></li><li><span class="g">150g</span><span>Patate douce</span></li><li><span class="g">200g</span><span>Courgettes</span></li></ul><div class="rm">583 kcal P:43g G:56g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 5</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Bowl frais</div><ul class="ri"><li><span class="g">150g</span><span>Yaourt grec 0%</span></li><li><span class="g">1 unite</span><span>Pomme</span></li><li><span class="g">20g</span><span>Amandes</span></li><li><span class="g">10g</span><span>Graines chia</span></li></ul><div class="rm">442 kcal P:33g G:43g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Thon naturel legumes rotis</div><ul class="ri"><li><span class="g">120g</span><span>Thon naturel</span></li><li><span class="g">150g</span><span>Courgettes</span></li><li><span class="g">100g</span><span>Carottes</span></li><li><span class="g">150g</span><span>Riz complet</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Compote amandes</div><ul class="ri"><li><span class="g">1 pot</span><span>Compote</span></li><li><span class="g">20g</span><span>Amandes</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Blanc de poulet sauce</div><ul class="ri"><li><span class="g">150g</span><span>Blanc de poulet</span></li><li><span class="g">150g</span><span>Champignons</span></li><li><span class="g">120g</span><span>Riz complet</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 6</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Porridge gourmand</div><ul class="ri"><li><span class="g">80g</span><span>Flocons avoine</span></li><li><span class="g">1 unite</span><span>Banane</span></li><li><span class="g">80g</span><span>Fruits rouges</span></li><li><span class="g">1 pincee</span><span>Cannelle</span></li></ul><div class="rm">462 kcal P:34g G:45g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Saumon salade</div><ul class="ri"><li><span class="g">150g</span><span>Saumon</span></li><li><span class="g">100g</span><span>Carottes</span></li><li><span class="g">150g</span><span>Tomates cerises</span></li><li><span class="g">demi</span><span>Avocat</span></li><li><span class="g">120g</span><span>Riz complet</span></li></ul><div class="rm">683 kcal P:51g G:66g L:24g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Fromage blanc banane</div><ul class="ri"><li><span class="g">150g</span><span>Fromage blanc 0%</span></li><li><span class="g">1 unite</span><span>Banane</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Thon naturel epinards</div><ul class="ri"><li><span class="g">120g</span><span>Thon naturel</span></li><li><span class="g">150g</span><span>Epinards</span></li><li><span class="g">150g</span><span>Brocoli</span></li><li><span class="g">150g</span><span>Patate douce</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 7</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Petit dej complet</div><ul class="ri"><li><span class="g">80g</span><span>Flocons avoine</span></li><li><span class="g">200ml</span><span>Lait demi-ecreme</span></li><li><span class="g">80g</span><span>Fruits rouges</span></li><li><span class="g">15g</span><span>Amandes</span></li></ul><div class="rm">442 kcal P:33g G:43g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Blanc de poulet citron</div><ul class="ri"><li><span class="g">150g</span><span>Blanc de poulet</span></li><li><span class="g">150g</span><span>Riz complet</span></li><li><span class="g">150g</span><span>Haricots verts</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Skyr pomme</div><ul class="ri"><li><span class="g">150g</span><span>Skyr nature</span></li><li><span class="g">1 unite</span><span>Pomme</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Saumon vapeur</div><ul class="ri"><li><span class="g">150g</span><span>Saumon</span></li><li><span class="g">150g</span><span>Courgettes</span></li><li><span class="g">100g</span><span>Champignons</span></li><li><span class="g">150g</span><span>Patate douce</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 8</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Bowl proteine</div><ul class="ri"><li><span class="g">150g</span><span>Yaourt grec 0%</span></li><li><span class="g">60g</span><span>Flocons avoine</span></li><li><span class="g">1 unite</span><span>Banane</span></li><li><span class="g">10g</span><span>Graines chia</span></li></ul><div class="rm">442 kcal P:33g G:43g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Thon naturel crudites</div><ul class="ri"><li><span class="g">120g</span><span>Thon naturel</span></li><li><span class="g">100g</span><span>Carottes</span></li><li><span class="g">150g</span><span>Tomates cerises</span></li><li><span class="g">demi</span><span>Avocat</span></li><li><span class="g">120g</span><span>Riz complet</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Galette amandes</div><ul class="ri"><li><span class="g">2 unites</span><span>Galette riz</span></li><li><span class="g">25g</span><span>Amandes</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Blanc de poulet poele epinards</div><ul class="ri"><li><span class="g">150g</span><span>Blanc de poulet</span></li><li><span class="g">150g</span><span>Epinards</span></li><li><span class="g">150g</span><span>Brocoli</span></li><li><span class="g">120g</span><span>Riz complet</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 9</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Tartines avocat</div><ul class="ri"><li><span class="g">2 tranches</span><span>Pain seigle</span></li><li><span class="g">demi</span><span>Avocat</span></li><li><span class="g">80g</span><span>Fruits rouges</span></li></ul><div class="rm">462 kcal P:34g G:45g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Saumon quinoa</div><ul class="ri"><li><span class="g">150g</span><span>Saumon</span></li><li><span class="g">150g</span><span>Brocoli</span></li><li><span class="g">100g</span><span>Tomates cerises</span></li><li><span class="g">150g</span><span>Patate douce</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Skyr kiwi</div><ul class="ri"><li><span class="g">150g</span><span>Skyr nature</span></li><li><span class="g">1 unite</span><span>Pomme</span></li></ul><div class="rm">241 kcal P:18g G:23g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Thon naturel sauce soja</div><ul class="ri"><li><span class="g">120g</span><span>Thon naturel</span></li><li><span class="g">150g</span><span>Courgettes</span></li><li><span class="g">100g</span><span>Champignons</span></li><li><span class="g">150g</span><span>Patate douce</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div><div class="jc"><div class="jh"><span class="jhn">Journee 10</span><span class="jhc">2009 kcal</span></div><div class="jb"><div class="rb"><div class="rl">Petit-dejeuner</div><div class="rn">Omelette fruits</div><ul class="ri"><li><span class="g">3 unites</span><span>Oeufs</span></li><li><span class="g">80g</span><span>Epinards</span></li><li><span class="g">1 unite</span><span>Pomme</span></li></ul><div class="rm">442 kcal P:33g G:43g L:16g</div></div><div class="rh"></div><div class="rb"><div class="rl">Dejeuner</div><div class="rn">Blanc de poulet legumes rotis</div><ul class="ri"><li><span class="g">150g</span><span>Blanc de poulet</span></li><li><span class="g">150g</span><span>Riz complet</span></li><li><span class="g">100g</span><span>Carottes</span></li><li><span class="g">150g</span><span>Courgettes</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">703 kcal P:52g G:68g L:25g</div></div><div class="rh"></div><div class="rb"><div class="rl">Collation</div><div class="rn">Compote graines</div><ul class="ri"><li><span class="g">1 pot</span><span>Compote</span></li><li><span class="g">10g</span><span>Graines chia</span></li><li><span class="g">15g</span><span>Amandes</span></li></ul><div class="rm">261 kcal P:19g G:25g L:9g</div></div><div class="rh"></div><div class="rb"><div class="rl">Diner</div><div class="rn">Saumon haricots</div><ul class="ri"><li><span class="g">150g</span><span>Saumon</span></li><li><span class="g">150g</span><span>Patate douce</span></li><li><span class="g">150g</span><span>Haricots verts</span></li><li><span class="g">10ml</span><span>Huile olive</span></li></ul><div class="rm">603 kcal P:45g G:58g L:21g</div></div></div></div></div>
<div class="pn" id="pn-jn">
<div id="jn-date-nav" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
  <button id="jn-prev" style="background:none;border:none;font-size:22px;color:#364d44;cursor:pointer;padding:8px;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">&#8249;</button>
  <div id="jn-date-label" style="font-family:'Cormorant Garamond',serif;font-size:18px;color:#364d44;text-align:center;"></div>
  <button id="jn-next" style="background:none;border:none;font-size:22px;color:#364d44;cursor:pointer;padding:8px;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">&#8250;</button>
</div>

<div id="jn-summary" style="background:#364d44;border-radius:16px;padding:1rem;margin-bottom:.85rem;">
  <div style="font-size:10px;color:#9FD4BC;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;font-weight:300;text-align:center;">Total du jour</div>
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px;text-align:center;">
    <div><div id="jn-tot-cal" style="font-family:'Cormorant Garamond',serif;font-size:20px;color:#FDFAF5;">0</div><div style="font-size:9px;color:#9FD4BC;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">kcal</div></div>
    <div><div id="jn-tot-p" style="font-family:'Cormorant Garamond',serif;font-size:20px;color:#FDFAF5;">0g</div><div style="font-size:9px;color:#9FD4BC;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">Prot</div></div>
    <div><div id="jn-tot-g" style="font-family:'Cormorant Garamond',serif;font-size:20px;color:#FDFAF5;">0g</div><div style="font-size:9px;color:#9FD4BC;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">Gluc</div></div>
    <div><div id="jn-tot-l" style="font-family:'Cormorant Garamond',serif;font-size:20px;color:#FDFAF5;">0g</div><div style="font-size:9px;color:#9FD4BC;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">Lip</div></div>
  </div>
</div>

<div id="jn-meals"></div>

<div id="jn-search-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:999;padding:1rem;">
  <div style="background:#FDFAF5;border-radius:20px;padding:1.25rem;max-height:90vh;overflow-y:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <div style="font-family:'Cormorant Garamond',serif;font-size:18px;color:#364d44;" id="jn-modal-title">Ajouter un aliment</div>
      <button id="jn-modal-close" style="background:none;border:none;font-size:24px;color:#999;cursor:pointer;-webkit-tap-highlight-color:transparent;">&#215;</button>
    </div>
    <div style="display:flex;gap:8px;margin-bottom:12px;">
      <input type="text" id="jn-search-input" placeholder="Ex: Pain Harry's, Yaourt Danone..." style="flex:1;background:#F5EFE6;border:1px solid #EDE5D8;border-radius:12px;padding:10px 14px;font-size:14px;color:#364d44;outline:none;font-family:'Jost',sans-serif;"/>
      <button id="jn-search-btn" style="background:#C96A52;color:#FDFAF5;border:none;border-radius:12px;padding:10px 16px;font-size:14px;cursor:pointer;font-family:'Jost',sans-serif;-webkit-tap-highlight-color:transparent;touch-action:manipulation;white-space:nowrap;">Chercher</button>
    </div>
    <div id="jn-search-results"></div>
    <div id="jn-qty-form" style="display:none;margin-top:12px;">
      <div id="jn-selected-name" style="font-family:'Cormorant Garamond',serif;font-size:16px;color:#364d44;margin-bottom:4px;"></div>
      <div id="jn-selected-macros" style="font-size:11px;color:#999;margin-bottom:12px;font-weight:300;"></div>
      <div style="display:flex;gap:8px;align-items:center;">
        <input type="number" id="jn-qty-input" placeholder="QuantitÃ© (g)" value="100" style="flex:1;background:#F5EFE6;border:1px solid #EDE5D8;border-radius:12px;padding:10px 14px;font-size:14px;color:#364d44;outline:none;font-family:'Jost',sans-serif;"/>
        <button id="jn-add-food-btn" style="background:#364d44;color:#FDFAF5;border:none;border-radius:12px;padding:10px 16px;font-size:14px;cursor:pointer;font-family:'Jost',sans-serif;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">Ajouter</button>
      </div>
    </div>
  </div>
</div>
</div>
<div class="ft"><div class="ftn">Le Cloud</div><div class="fts">Coaching sportif priv&eacute;</div></div>
<script>
document.getElementById('tb-m').addEventListener('click',function(){sw('m');});
document.getElementById('tb-c').addEventListener('click',function(){sw('c');});
document.getElementById('tb-j').addEventListener('click',function(){sw('j');});
document.getElementById('tb-jn').addEventListener('click',function(){sw('jn');});
function sw(n){
document.querySelectorAll('.tb').forEach(function(t){t.classList.remove('on');});
document.querySelectorAll('.pn').forEach(function(p){p.classList.remove('on');});
document.getElementById('tb-'+n).classList.add('on');
document.getElementById('pn-'+n).classList.add('on');
if(n==='jn') jnRender();
}
// ===== JOURNAL =====
var JN = {
  currentDate: new Date(),
  data: {},
  selectedFood: null,
  currentMeal: null
};

var JN_MEALS = ['Petit-dejeuner','Dejeuner','Collation','Diner'];

function jnDateKey(d) {
  return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate();
}

function jnFmt(d) {
  var days = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
  var months = ['jan','fev','mar','avr','mai','jun','jul','aou','sep','oct','nov','dec'];
  var today = new Date();
  var isToday = jnDateKey(d) === jnDateKey(today);
  var label = days[d.getDay()] + ' ' + d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear();
  return isToday ? 'Aujourd\u2019hui \u2014 ' + label : label;
}

function jnLoad() {
  try { JN.data = JSON.parse(localStorage.getItem('jn_data') || '{}'); } catch(e) { JN.data = {}; }
}

function jnSave() {
  try { localStorage.setItem('jn_data', JSON.stringify(JN.data)); } catch(e) {}
}

function jnGetDay() {
  var k = jnDateKey(JN.currentDate);
  if (!JN.data[k]) {
    JN.data[k] = {};
    JN_MEALS.forEach(function(m) { JN.data[k][m] = []; });
  }
  return JN.data[k];
}

function jnRender() {
  document.getElementById('jn-date-label').textContent = jnFmt(JN.currentDate);
  var day = jnGetDay();
  var totCal=0,totP=0,totG=0,totL=0;
  var html = '';
  JN_MEALS.forEach(function(meal) {
    var items = day[meal] || [];
    var mCal=0,mP=0,mG=0,mL=0;
    items.forEach(function(f){mCal+=f.cal;mP+=f.p;mG+=f.g;mL+=f.l;});
    totCal+=mCal;totP+=mP;totG+=mG;totL+=mL;
    html += '<div class="meal-card">';
    html += '<div class="meal-head"><span class="meal-name">'+meal+'</span><span class="meal-cals">'+(mCal>0?Math.round(mCal)+' kcal':'')+'</span></div>';
    html += '<div class="meal-body">';
    items.forEach(function(f,i){
      html += '<div class="food-item">';
      html += '<div class="food-name">'+f.name+(f.qty!==100?' ('+f.qty+'g)':'')+'</div>';
      html += '<div class="food-macros">'+Math.round(f.cal)+' kcal Â· P:'+Math.round(f.p)+'g G:'+Math.round(f.g)+'g L:'+Math.round(f.l)+'g</div>';
      html += '<button class="food-del" data-meal="'+meal+'" data-idx="'+i+'" data-action="del">&#215;</button>';
      html += '</div>';
    });
    html += '<button class="add-food-btn" data-meal="'+meal+'" data-action="addfood"><span style="font-size:18px;line-height:1;color:#C96A52;">+</span> Ajouter un aliment</button>';
    html += '</div></div>';
  });
  document.getElementById('jn-meals').innerHTML = html;
  document.getElementById('jn-tot-cal').textContent = Math.round(totCal);
  document.getElementById('jn-tot-p').textContent = Math.round(totP)+'g';
  document.getElementById('jn-tot-g').textContent = Math.round(totG)+'g';
  document.getElementById('jn-tot-l').textContent = Math.round(totL)+'g';
}

function jnDel(meal, idx) {
  var day = jnGetDay();
  day[meal].splice(idx,1);
  jnSave();
  jnRender();
}

function jnOpenSearch(meal) {
  JN.currentMeal = meal;
  JN.selectedFood = null;
  document.getElementById('jn-modal-title').textContent = 'Ajouter â ' + meal;
  document.getElementById('jn-search-input').value = '';
  document.getElementById('jn-search-results').innerHTML = '';
  document.getElementById('jn-qty-form').style.display = 'none';
  document.getElementById('jn-search-modal').style.display = 'block';
  setTimeout(function(){ document.getElementById('jn-search-input').focus(); }, 100);
}

function jnCloseSearch() {
  document.getElementById('jn-search-modal').style.display = 'none';
}

